# Google Gemini/Gemma API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (gemini-3.1-flash-lite is recommended for speed and reliability)
GEMMA_MODEL=gemini-3.1-flash-lite

# AI Provider (currently: google)
AI_PROVIDER=google

# Supabase (optional - leave blank to run without database)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload limits
MAX_UPLOAD_MB=5
MAX_RESUME_TEXT_CHARS=15000
MAX_JOB_DESCRIPTION_CHARS=8000

# Environment
ENVIRONMENT=development
